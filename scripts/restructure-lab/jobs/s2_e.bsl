// S1-E (cases e1, e3, e4): new tabular sections and new attributes of existing tabular sections, catalogs (flat and hierarchical) and
// documents. The job walks the ten objects the three cases change (the ones a case leaves alone are checked the same way, as a
// control) and reports, for each: the attributes and the tabular sections the metadata has, with the attributes of each section and
// their indexing; how many rows each section holds and a digest of the values of all its attributes (the data of the sections
// that were there must not change, and a new section is empty); the XDTO serialization of a new object with a row in every
// section (the model cache row must know every section and every attribute); a write of that object, read back, queried through
// each section (the attributes that are indexed are read in the order of their index), and deleted again. The output has no times
// or generated names, so two twins can be compared as text. No procedure is declared (the job runs through Выполнить()).
Результат = "";
Объекты = Новый Массив;
Для Каждого Имя Из СтрРазделить("_ДемоСтавкиНДС,_ДемоМестаХранения,_ДемоКонтактныеЛицаПартнеров,_ДемоПодразделения,_ДемоОрганизации,_ДемоПартнеры", ",", Ложь) Цикл
	Объекты.Добавить(Новый Структура("Вид,Имя", "Справочник", Имя));
КонецЦикла;
Для Каждого Имя Из СтрРазделить("_ДемоСчетФактураПолученный,_ДемоСписаниеТоваров,_ДемоОприходованиеТоваров,_ДемоОтпускаСотрудников", ",", Ложь) Цикл
	Объекты.Добавить(Новый Структура("Вид,Имя", "Документ", Имя));
КонецЦикла;

Для Каждого Описание Из Объекты Цикл
	Попытка
		Вид = Описание.Вид;
		Если Вид = "Справочник" Тогда
			Менеджер = Справочники[Описание.Имя];
			ОбъектМД = Метаданные.Справочники[Описание.Имя];
		Иначе
			Менеджер = Документы[Описание.Имя];
			ОбъектМД = Метаданные.Документы[Описание.Имя];
		КонецЕсли;
		Результат = Результат + "== " + Вид + "." + ОбъектМД.Имя + Символы.ПС;
		Имена = "";
		Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
			Имена = Имена + Реквизит.Имя + " ";
		КонецЦикла;
		Результат = Результат + "  attributes: " + Имена + Символы.ПС;

		// 1. the sections the metadata has, their attributes with the indexing, the rows they hold
		Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
			Имена = "";
			Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
				Имена = Имена + Реквизит.Имя + "(" + Реквизит.Индексирование + ") ";
			КонецЦикла;
			Результат = Результат + "  section " + ТЧ.Имя + ": " + Имена + Символы.ПС;
			Поля = "Т.Ссылка КАК Ссылка, Т.НомерСтроки КАК НомерСтроки";
			Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
				Поля = Поля + ", Т." + Реквизит.Имя + " КАК " + Реквизит.Имя;
			КонецЦикла;
			Запрос = Новый Запрос("ВЫБРАТЬ " + Поля + " ИЗ " + Вид + "." + ОбъектМД.Имя + "." + ТЧ.Имя + " КАК Т");
			Выборка = Запрос.Выполнить().Выбрать();
			Строки = Новый СписокЗначений;
			Пока Выборка.Следующий() Цикл
				ЗначениеСтроки = Строка(Выборка.Ссылка.УникальныйИдентификатор()) + "|" + Выборка.НомерСтроки;
				Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
					ЗначениеСтроки = ЗначениеСтроки + "|" + Строка(Выборка[Реквизит.Имя]);
				КонецЦикла;
				Строки.Добавить(ЗначениеСтроки);
			КонецЦикла;
			Строки.СортироватьПоЗначению();
			Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
			Для Каждого Элемент Из Строки Цикл
				Хеш.Добавить(Элемент.Значение + Символы.ПС);
			КонецЦикла;
			Результат = Результат + "    rows: " + Строки.Количество() + ", digest " + Хеш.ХешСумма + Символы.ПС;
		КонецЦикла;

		// 2. a new object with a row in every section: the XDTO serialization knows every section and attribute
		Если Вид = "Справочник" Тогда
			НовыйОбъект = Менеджер.СоздатьЭлемент();
			НовыйОбъект.Наименование = "ДДЛ E " + ОбъектМД.Имя;
		Иначе
			НовыйОбъект = Менеджер.СоздатьДокумент();
			НовыйОбъект.Дата = Дата(2026, 9, 30, 12, 0, 0);
		КонецЕсли;
		НовыйОбъект.ОбменДанными.Загрузка = Истина;
		Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
			Типы = Реквизит.Тип.Типы();
			Если Типы.Количество() <> 1 Тогда
				Продолжить;
			КонецЕсли;
			Если Типы[0] = Тип("Булево") Тогда
				НовыйОбъект[Реквизит.Имя] = Истина;
			ИначеЕсли Типы[0] = Тип("Строка") Тогда
				НовыйОбъект[Реквизит.Имя] = "знач";
			ИначеЕсли Типы[0] = Тип("Число") Тогда
				НовыйОбъект[Реквизит.Имя] = ?(Реквизит.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти > 0, 3.5, 4);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
			Для Номер = 1 По 2 Цикл
				НоваяСтрока = НовыйОбъект[ТЧ.Имя].Добавить();
				Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
					Типы = Реквизит.Тип.Типы();
					Если Типы.Количество() <> 1 Тогда
						Продолжить;
					КонецЕсли;
					Если Типы[0] = Тип("Булево") Тогда
						НоваяСтрока[Реквизит.Имя] = (Номер = 1);
					ИначеЕсли Типы[0] = Тип("Строка") Тогда
						НоваяСтрока[Реквизит.Имя] = "стр" + Номер;
					ИначеЕсли Типы[0] = Тип("Число") Тогда
						НоваяСтрока[Реквизит.Имя] = ?(Реквизит.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти > 0, Номер + 0.25, Номер);
					ИначеЕсли Типы[0] = Тип("Дата") Тогда
						НоваяСтрока[Реквизит.Имя] = Дата(2026, 9, 30, 0, 0, 0) + Номер * 86400;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, НовыйОбъект);
		Текст = ЗаписьXML.Закрыть();
		Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
			Найдено = 0;
			Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
				Если СтрНайти(Текст, "<" + Реквизит.Имя + ">") > 0 Или СтрНайти(Текст, "<" + Реквизит.Имя + "/>") > 0 Тогда
					Найдено = Найдено + 1;
				КонецЕсли;
			КонецЦикла;
			Результат = Результат + "  xdto: section " + ТЧ.Имя + " in the serialization: " + (СтрНайти(Текст, "<" + ТЧ.Имя + ">") > 0) + ", attributes found " + Найдено + " of " + ТЧ.Реквизиты.Количество() + Символы.ПС;
		КонецЦикла;

		// 3. write it, read it back, query through every section, delete it
		НовыйОбъект.Записать();
		Ссылка = НовыйОбъект.Ссылка;
		Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
			Строк = Ссылка[ТЧ.Имя].Количество();
			Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число ИЗ " + Вид + "." + ОбъектМД.Имя + "." + ТЧ.Имя + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			Выборка = Запрос.Выполнить().Выбрать();
			Выборка.Следующий();
			Результат = Результат + "  " + ТЧ.Имя + ": written " + Строк + " rows, query finds " + Выборка.Число + Символы.ПС;
			Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
				Если Реквизит.Индексирование = Метаданные.СвойстваОбъектов.Индексирование.НеИндексировать Тогда
					Продолжить;
				КонецЕсли;
				Запрос = Новый Запрос("ВЫБРАТЬ Т." + Реквизит.Имя + " КАК Значение ИЗ " + Вид + "." + ОбъектМД.Имя + "." + ТЧ.Имя + " КАК Т ГДЕ Т.Ссылка = &Ссылка УПОРЯДОЧИТЬ ПО Т." + Реквизит.Имя + " УБЫВ, Т.НомерСтроки");
				Запрос.УстановитьПараметр("Ссылка", Ссылка);
				Выборка = Запрос.Выполнить().Выбрать();
				Порядок = "";
				Пока Выборка.Следующий() Цикл
					Порядок = Порядок + Строка(Выборка.Значение) + ";";
				КонецЦикла;
				Результат = Результат + "    ordered by " + Реквизит.Имя + " (indexed): " + Порядок + Символы.ПС;
			КонецЦикла;
		КонецЦикла;
		Ссылка.ПолучитьОбъект().Удалить();
		Результат = Результат + "  test object deleted" + Символы.ПС;
	Исключение
		Результат = Результат + "  ERROR: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС;
	КонецПопытки;
КонецЦикла;
