// S1-D (case d1): the index flag of attributes switched on and off in catalogs (flat and hierarchical) and documents, with and
// without the additional order, in one session. For each object: the indexing the metadata reports for the switched attributes and
// the rows read in the order of each of them, then (as in the other cases) the attributes, the rows with a digest, the XDTO
// serialization and a write of a new object that is read back.
// For each object: the attributes the metadata reports, that the deleted ones are gone (and the added ones
// there), how many rows and a digest of the values of every remaining attribute of every row (a deletion
// must not touch the data of the others), the XDTO serialization of an existing object (needs the model
// cache row: no deleted attribute in it), and a write of a new object read back and found by a query; the
// test object is deleted again. The output has no times or generated names, so two twins can be compared
// as text. No procedure is declared (the job runs through Выполнить()).
Результат = "";
Объекты = Новый Массив;
Объекты.Добавить(Новый Структура("Вид,Имя,Удалены,Добавлены,ЧитатьОбъект,Индексные", "Справочник", "КлючевыеОперации", "", "", Истина, "ЦелевоеВремя,Приоритет,ВыполненаСОшибкой"));
Объекты.Добавить(Новый Структура("Вид,Имя,Удалены,Добавлены,ЧитатьОбъект,Индексные", "Справочник", "КлассификаторБанков", "", "", Истина, "Город,Телефоны"));
Объекты.Добавить(Новый Структура("Вид,Имя,Удалены,Добавлены,ЧитатьОбъект,Индексные", "Справочник", "ТомаХраненияФайлов", "", "", Истина, "МаксимальныйРазмер,ПорядокЗаполнения"));
Объекты.Добавить(Новый Структура("Вид,Имя,Удалены,Добавлены,ЧитатьОбъект,Индексные", "Документ", "_ДемоЗаказПокупателя", "", "", Истина, "РегионДоставки,ДатаДоставки,СтатусЗаказа"));
Объекты.Добавить(Новый Структура("Вид,Имя,Удалены,Добавлены,ЧитатьОбъект,Индексные", "Справочник", "_ДемоПроекты", "", "", Истина, "РеквизитДопУпорядочивания"));
Объекты.Добавить(Новый Структура("Вид,Имя,Удалены,Добавлены,ЧитатьОбъект,Индексные", "Документ", "_ДемоНачислениеЗарплаты", "", "", Истина, "ПериодРегистрации"));

Для Каждого Описание Из Объекты Цикл
	Попытка
		Вид = Описание.Вид;
		Если Вид = "Справочник" Тогда
			Менеджер = Справочники[Описание.Имя];
			ОбъектМД = Метаданные.Справочники[Описание.Имя];
		Иначе
			Менеджер = Документы[Описание.Имя];
			ОбъектМД = Метаданные.Документы[Описание.Имя];
		КонецЕсли;
		Результат = Результат + "== " + Вид + "." + ОбъектМД.Имя + Символы.ПС;
		Имена = "";
		Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
			Имена = Имена + Реквизит.Имя + " ";
		КонецЦикла;
		Результат = Результат + "  attributes: " + Имена + Символы.ПС;
		// the indexing the metadata reports, and the attribute read in the order of its own index
		Для Каждого Имя Из СтрРазделить(Описание.Индексные, ",", Ложь) Цикл
			РеквизитМД = ОбъектМД.Реквизиты.Найти(Имя);
			Результат = Результат + "  indexing " + Имя + ": " + РеквизитМД.Индексирование + Символы.ПС;
			Запрос = Новый Запрос("ВЫБРАТЬ " + Имя + " КАК Значение ИЗ " + Вид + "." + ОбъектМД.Имя + " УПОРЯДОЧИТЬ ПО " + Имя + ", Ссылка");
			Выборка = Запрос.Выполнить().Выбрать();
			Порядок = "";
			Число = 0;
			Пока Выборка.Следующий() Цикл
				Число = Число + 1;
				Порядок = Порядок + Строка(Выборка.Значение) + ";";
			КонецЦикла;
			ХешПорядка = Новый ХешированиеДанных(ХешФункция.MD5);
			ХешПорядка.Добавить(Порядок);
			Результат = Результат + "  ordered by " + Имя + ": " + Число + " rows, digest " + ХешПорядка.ХешСумма + Символы.ПС;
		КонецЦикла;
		Для Каждого Имя Из СтрРазделить(Описание.Удалены, ",", Ложь) Цикл
			Результат = Результат + "  deleted " + Имя + " is gone: " + (ОбъектМД.Реквизиты.Найти(Имя) = Неопределено) + Символы.ПС;
		КонецЦикла;
		Для Каждого Имя Из СтрРазделить(Описание.Добавлены, ",", Ложь) Цикл
			Результат = Результат + "  added " + Имя + " is there: " + (ОбъектМД.Реквизиты.Найти(Имя) <> Неопределено) + Символы.ПС;
		КонецЦикла;

		// 1. existing rows: how many and a digest of the values of the attributes that were there before
		Оставшиеся = Новый Массив;
		Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
			Если СтрНайти("," + Описание.Добавлены + ",", "," + Реквизит.Имя + ",") = 0 Тогда
				Оставшиеся.Добавить(Реквизит.Имя);
			КонецЕсли;
		КонецЦикла;
		Поля = "Ссылка";
		Для Каждого Имя Из Оставшиеся Цикл
			Поля = Поля + ", " + Имя;
		КонецЦикла;
		Запрос = Новый Запрос("ВЫБРАТЬ " + Поля + " ИЗ " + Вид + "." + ОбъектМД.Имя);
		Выборка = Запрос.Выполнить().Выбрать();
		Строки = Новый СписокЗначений;
		Пока Выборка.Следующий() Цикл
			ЗначениеСтроки = Строка(Выборка.Ссылка.УникальныйИдентификатор());
			Для Каждого Имя Из Оставшиеся Цикл
				ЗначениеСтроки = ЗначениеСтроки + "|" + Строка(Выборка[Имя]);
			КонецЦикла;
			Строки.Добавить(ЗначениеСтроки);
		КонецЦикла;
		Строки.СортироватьПоЗначению();
		Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
		Для Каждого Элемент Из Строки Цикл
			Хеш.Добавить(Элемент.Значение + Символы.ПС);
		КонецЦикла;
		Результат = Результат + "  rows: " + Строки.Количество() + ", digest of the kept attributes " + Хеш.ХешСумма + Символы.ПС;

		// 2a. (not used in this case: every object here can be read as an object)
		Если Не Описание.ЧитатьОбъект Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ Ссылка.Номер КАК Номер, Дата КАК Дата ИЗ " + Вид + "." + ОбъектМД.Имя + " КАК Т УПОРЯДОЧИТЬ ПО Дата, Ссылка");
			Выборка = Запрос.Выполнить().Выбрать();
			Порядок = "";
			Пока Выборка.Следующий() Цикл
				Порядок = Порядок + Выборка.Номер + "@" + Формат(Выборка.Дата, "ДФ=yyyyMMddHHmmss") + " ";
			КонецЦикла;
			Результат = Результат + "  ordered by date: " + Порядок + Символы.ПС;
			Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число ИЗ " + Вид + "." + ОбъектМД.Имя + " ГДЕ Дата >= &Начало И Дата <= &Конец");
			Запрос.УстановитьПараметр("Начало", Дата(2000, 1, 1));
			Запрос.УстановитьПараметр("Конец", Дата(2100, 1, 1));
			Выборка = Запрос.Выполнить().Выбрать();
			Выборка.Следующий();
			Результат = Результат + "  in the period: " + Выборка.Число + Символы.ПС;
			Продолжить;
		КонецЕсли;

		// 2. XDTO serialization of an existing object: no deleted attribute in it
		Выборка = Менеджер.Выбрать();
		Найден = Ложь;
		Пока Выборка.Следующий() Цикл
			Если Вид = "Справочник" И Выборка.ЭтоГруппа Тогда
				Продолжить;
			КонецЕсли;
			ЗаписьXML = Новый ЗаписьXML;
			ЗаписьXML.УстановитьСтроку();
			СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Выборка.ПолучитьОбъект());
			Текст = ЗаписьXML.Закрыть();
			Осталось = "";
			Для Каждого Имя Из СтрРазделить(Описание.Удалены, ",", Ложь) Цикл
				Если СтрНайти(Текст, "<" + Имя + ">") > 0 Или СтрНайти(Текст, "<" + Имя + "/>") > 0 Тогда
					Осталось = Осталось + Имя + " ";
				КонецЕсли;
			КонецЦикла;
			Результат = Результат + "  xdto: no deleted attribute in the serialization: " + (Осталось = "") + ?(Осталось = "", "", " still there: " + Осталось) + Символы.ПС;
			Найден = Истина;
			Прервать;
		КонецЦикла;
		Если Не Найден Тогда
			Результат = Результат + "  xdto: no object to serialize" + Символы.ПС;
		КонецЕсли;

		// 3. write a new object with a value in every remaining string / number attribute, read back, query
		Если Вид = "Справочник" Тогда
			НовыйОбъект = Менеджер.СоздатьЭлемент();
			НовыйОбъект.Наименование = "ДДЛ D1 " + ОбъектМД.Имя;
		Иначе
			НовыйОбъект = Менеджер.СоздатьДокумент();
			НовыйОбъект.Дата = Дата(2026, 9, 29, 12, 0, 0);
		КонецЕсли;
		НовыйОбъект.ОбменДанными.Загрузка = Истина;
		Задано = Новый Соответствие;
		Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
			Типы = Реквизит.Тип.Типы();
			Значение = Неопределено;
			Если Типы.Количество() = 1 Тогда
				Если Типы[0] = Тип("Булево") Тогда
					Значение = Истина;
				ИначеЕсли Типы[0] = Тип("Строка") Тогда
					Значение = "значение";
				ИначеЕсли Типы[0] = Тип("Число") Тогда
					Значение = ?(Реквизит.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти > 0, 3.5, 4);
				КонецЕсли;
			КонецЕсли;
			Если Значение <> Неопределено Тогда
				НовыйОбъект[Реквизит.Имя] = Значение;
				Задано.Вставить(Реквизит.Имя, Значение);
			КонецЕсли;
		КонецЦикла;
		НовыйОбъект.Записать();
		Ссылка = НовыйОбъект.Ссылка;
		Совпало = 0;
		Всего = 0;
		Для Каждого Пара Из Задано Цикл
			Всего = Всего + 1;
			Если Ссылка[Пара.Ключ] = Пара.Значение Тогда
				Совпало = Совпало + 1;
			КонецЕсли;
		КонецЦикла;
		Результат = Результат + "  wrote " + Всего + " attribute values, read back equal: " + Совпало + Символы.ПС;
		Ссылка.ПолучитьОбъект().Удалить();
		Результат = Результат + "  test object deleted" + Символы.ПС;
	Исключение
		Результат = Результат + "  ERROR: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС;
	КонецПопытки;
КонецЦикла;
