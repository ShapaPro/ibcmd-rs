// S1-K case f1/f2 (from the trace track's f_created.bsl, S1-F #402): a session job over the catalog and the document the case creates (the names ДемоКатФ*, ДемоДокФ*) and the catalog that gains an attribute beside them (_ДемоСтавкиНДС in N3, N6, N7).
// For each one: what the metadata reports (the type index, the names), the attributes and tabular sections, the XDTO type
// of the object and of its reference (the model cache row), a write of a group and an element (or a document) with a value in every
// attribute and tabular row, read back and found by queries (each attribute alone and the ordering by it), the XDTO
// serialization of the written object (the element names, no values), and the deletion of the test objects. The output has
// no times, no references and no generated names, so two twins can be compared as text. No procedure is declared (the job
// runs through Выполнить()).
Результат = "";
Объекты = Новый Массив;
Для Каждого ОбъектМД Из Метаданные.Справочники Цикл
	Включить = СтрНачинаетсяС(ОбъектМД.Имя, "ДемоКатФ");
	// the existing catalog a case adds an attribute to (N3, N6, N7): its new attribute is named ДемоН..Реквизит
	Если ОбъектМД.Имя = "_ДемоСтавкиНДС" Тогда
		Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
			Если СтрНачинаетсяС(Реквизит.Имя, "ДемоН") Тогда
				Включить = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Включить Тогда
		Объекты.Добавить(Новый Структура("Вид,МД", "Справочник", ОбъектМД));
	КонецЕсли;
КонецЦикла;
Для Каждого ОбъектМД Из Метаданные.Документы Цикл
	Если СтрНачинаетсяС(ОбъектМД.Имя, "ДемоДокФ") Тогда
		Объекты.Добавить(Новый Структура("Вид,МД", "Документ", ОбъектМД));
	КонецЕсли;
КонецЦикла;
Результат = Результат + "objects: " + Объекты.Количество() + Символы.ПС;

Для Каждого Описание Из Объекты Цикл
	Записаны = Новый Массив;
	Попытка
		Вид = Описание.Вид;
		ОбъектМД = Описание.МД;
		ПолноеИмя = Вид + "." + ОбъектМД.Имя;
		Если Вид = "Справочник" Тогда
			Менеджер = Справочники[ОбъектМД.Имя];
			ТипСсылки = Тип("СправочникСсылка." + ОбъектМД.Имя);
			ИмяXDTO = "CatalogObject." + ОбъектМД.Имя;
			ИмяСсылкиXDTO = "CatalogRef." + ОбъектМД.Имя;
		Иначе
			Менеджер = Документы[ОбъектМД.Имя];
			ТипСсылки = Тип("ДокументСсылка." + ОбъектМД.Имя);
			ИмяXDTO = "DocumentObject." + ОбъектМД.Имя;
			ИмяСсылкиXDTO = "DocumentRef." + ОбъектМД.Имя;
		КонецЕсли;
		Результат = Результат + "== " + ПолноеИмя + Символы.ПС;

		// 1. the metadata: found by name, by the reference type, the synonym
		Результат = Результат + "  found by name: " + (Метаданные.НайтиПоПолномуИмени(ПолноеИмя) <> Неопределено) + Символы.ПС;
		ПоТипу = Метаданные.НайтиПоТипу(ТипСсылки);
		Результат = Результат + "  found by the reference type: " + ?(ПоТипу = Неопределено, "no", ПоТипу.ПолноеИмя()) + Символы.ПС;
		Результат = Результат + "  synonym: " + ОбъектМД.Синоним + Символы.ПС;
		Если Вид = "Справочник" Тогда
			Результат = Результат + "  hierarchical: " + ОбъектМД.Иерархический + ", kind " + ОбъектМД.ВидИерархии + ", code " + ОбъектМД.ДлинаКода + " " + ОбъектМД.ТипКода + ", name " + ОбъектМД.ДлинаНаименования + Символы.ПС;
		Иначе
			Результат = Результат + "  number: " + ОбъектМД.ДлинаНомера + " " + ОбъектМД.ТипНомера + ", periodicity " + ОбъектМД.ПериодичностьНомера + Символы.ПС;
		КонецЕсли;
		Имена = "";
		Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
			Имена = Имена + Реквизит.Имя + "(" + Реквизит.Индексирование + ") ";
		КонецЦикла;
		Результат = Результат + "  attributes: " + Имена + Символы.ПС;
		Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
			Имена = "";
			Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
				Имена = Имена + Реквизит.Имя + "(" + Реквизит.Индексирование + ") ";
			КонецЦикла;
			Результат = Результат + "  tabular section " + ТЧ.Имя + ": " + Имена + Символы.ПС;
		КонецЦикла;
		// 2. the XDTO types of the object and of its reference: the properties in the model
		Для Каждого ИмяТипа Из СтрРазделить(ИмяXDTO + "," + ИмяСсылкиXDTO, ",") Цикл
			ТипXDTO = ФабрикаXDTO.Тип("http://v8.1c.ru/8.1/data/enterprise/current-config", ИмяТипа);
			Если ТипЗнч(ТипXDTO) = Тип("ТипОбъектаXDTO") Тогда
				Свойства = "";
				Для Каждого Свойство Из ТипXDTO.Свойства Цикл
					Свойства = Свойства + Свойство.Имя + ?(Свойство.ВозможноПустое, "?", "") + " ";
				КонецЦикла;
				Результат = Результат + "  xdto " + ИмяТипа + ": " + ТипXDTO.Свойства.Количество() + " properties: " + Свойства + Символы.ПС;
			Иначе
				Результат = Результат + "  xdto " + ИмяТипа + ": " + ТипЗнч(ТипXDTO) + Символы.ПС;
			КонецЕсли;
		КонецЦикла;

		// 3. the write: a group (hierarchical catalog) and an element or a document, a value in every attribute
		Пользователь = Неопределено;
		Выборка = Справочники.Пользователи.Выбрать();
		Если Выборка.Следующий() Тогда
			Пользователь = Выборка.Ссылка;
		КонецЕсли;
		Записаны = Новый Массив;
		Для Каждого Роль Из СтрРазделить(?(Вид = "Справочник" И ОбъектМД.Иерархический, "Группа,Элемент", "Элемент"), ",") Цикл
			Если Вид = "Справочник" Тогда
				Если Роль = "Группа" Тогда
					НовыйОбъект = Менеджер.СоздатьГруппу();
					НовыйОбъект.Наименование = "F группа " + ОбъектМД.Имя;
				Иначе
					НовыйОбъект = Менеджер.СоздатьЭлемент();
					НовыйОбъект.Наименование = "F элемент " + ОбъектМД.Имя;
					Если ОбъектМД.Иерархический И Записаны.Количество() > 0 Тогда
						НовыйОбъект.Родитель = Записаны[0];
					КонецЕсли;
				КонецЕсли;
			Иначе
				НовыйОбъект = Менеджер.СоздатьДокумент();
				НовыйОбъект.Дата = Дата(2026, 9, 30, 12, 0, 0);
			КонецЕсли;
			НовыйОбъект.ОбменДанными.Загрузка = Истина;
			Задано = Новый Соответствие;
			Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
				Если Вид = "Справочник" И ОбъектМД.Иерархический Тогда
					Если Роль = "Группа" И Реквизит.Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента Тогда
						Продолжить;
					КонецЕсли;
					Если Роль = "Элемент" И Реквизит.Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппы Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				Типы = Реквизит.Тип.Типы();
				Значение = Неопределено;
				Если Типы.Количество() = 1 Тогда
					Если Типы[0] = Тип("Булево") Тогда
						Значение = Истина;
					ИначеЕсли Типы[0] = Тип("Строка") Тогда
						Значение = "значение";
					ИначеЕсли Типы[0] = Тип("Число") Тогда
						Значение = ?(Реквизит.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти > 0, 3.5, 4);
					ИначеЕсли Типы[0] = Тип("Дата") Тогда
						Значение = Дата(2026, 9, 30, 10, 20, 30);
					ИначеЕсли Типы[0] = Тип("СправочникСсылка.Пользователи") Тогда
						Значение = Пользователь;
					КонецЕсли;
				КонецЕсли;
				Если Значение <> Неопределено Тогда
					НовыйОбъект[Реквизит.Имя] = Значение;
					Задано.Вставить(Реквизит.Имя, Значение);
				КонецЕсли;
			КонецЦикла;
			ЧислоСтрок = 0;
			Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
				Если Вид = "Справочник" И Роль = "Группа" Тогда
					Продолжить;
				КонецЕсли;
				Для Номер = 1 По 3 Цикл
					СтрокаТЧ = НовыйОбъект[ТЧ.Имя].Добавить();
					ЧислоСтрок = ЧислоСтрок + 1;
					Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
						Типы = Реквизит.Тип.Типы();
						Если Типы.Количество() <> 1 Тогда
							Продолжить;
						КонецЕсли;
						Если Типы[0] = Тип("Число") Тогда
							СтрокаТЧ[Реквизит.Имя] = Номер + 0.5;
						ИначеЕсли Типы[0] = Тип("Строка") Тогда
							СтрокаТЧ[Реквизит.Имя] = "строка " + Номер;
						ИначеЕсли Типы[0] = Тип("СправочникСсылка.Пользователи") Тогда
							СтрокаТЧ[Реквизит.Имя] = Пользователь;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
			НовыйОбъект.Записать();
			Ссылка = НовыйОбъект.Ссылка;
			Записаны.Добавить(Ссылка);
			Совпало = 0;
			Всего = 0;
			Для Каждого Пара Из Задано Цикл
				Всего = Всего + 1;
				Если Ссылка[Пара.Ключ] = Пара.Значение Тогда
					Совпало = Совпало + 1;
				КонецЕсли;
			КонецЦикла;
			Результат = Результат + "  wrote the " + Роль + ": " + Всего + " attribute values, read back equal: " + Совпало + ", tabular rows " + ЧислоСтрок + Символы.ПС;
			ПрочитаноСтрок = 0;
			Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
				ПрочитаноСтрок = ПрочитаноСтрок + Ссылка.ПолучитьОбъект()[ТЧ.Имя].Количество();
			КонецЦикла;
			Результат = Результат + "  " + Роль + ": tabular rows read back " + ПрочитаноСтрок + Символы.ПС;

			// 4. the XDTO serialization of the written object: the element names in their order
			ЗаписьXML = Новый ЗаписьXML;
			ЗаписьXML.УстановитьСтроку();
			СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Ссылка.ПолучитьОбъект());
			Текст = ЗаписьXML.Закрыть();
			ЧтениеXML = Новый ЧтениеXML;
			ЧтениеXML.УстановитьСтроку(Текст);
			ИменаЭлементов = "";
			Уровень = 0;
			Пока ЧтениеXML.Прочитать() Цикл
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
					Уровень = Уровень + 1;
					Если Уровень <= 2 Тогда
						ИменаЭлементов = ИменаЭлементов + ЧтениеXML.ЛокальноеИмя + " ";
					КонецЕсли;
				ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
					Уровень = Уровень - 1;
				КонецЕсли;
			КонецЦикла;
			ЧтениеXML.Закрыть();
			Результат = Результат + "  " + Роль + " xdto elements: " + ИменаЭлементов + Символы.ПС;
		КонецЦикла;

		// 5. queries: the count, each attribute alone, the ordering by each attribute, the tabular section
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число ИЗ " + ПолноеИмя);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Результат = Результат + "  rows: " + Выборка.Число + Символы.ПС;
		Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
			Попытка
				Запрос = Новый Запрос("ВЫБРАТЬ Ссылка КАК Ссылка, " + Реквизит.Имя + " КАК Значение ИЗ " + ПолноеИмя + " УПОРЯДОЧИТЬ ПО " + Реквизит.Имя + ", Ссылка");
				Выборка = Запрос.Выполнить().Выбрать();
				Число = 0;
				Пока Выборка.Следующий() Цикл
					Число = Число + 1;
				КонецЦикла;
				Результат = Результат + "  ordered by " + Реквизит.Имя + ": " + Число + " rows" + Символы.ПС;
			Исключение
				Результат = Результат + "  ordered by " + Реквизит.Имя + ": not possible (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")" + Символы.ПС;
			КонецПопытки;
		КонецЦикла;
		Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
			Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число, СУММА(Т.Количество) КАК Итого ИЗ " + ПолноеИмя + "." + ТЧ.Имя + " КАК Т");
			Попытка
				Выборка = Запрос.Выполнить().Выбрать();
				Выборка.Следующий();
				Результат = Результат + "  section " + ТЧ.Имя + ": " + Выборка.Число + " rows, total " + Выборка.Итого + Символы.ПС;
			Исключение
				Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число ИЗ " + ПолноеИмя + "." + ТЧ.Имя + " КАК Т");
				Выборка = Запрос.Выполнить().Выбрать();
				Выборка.Следующий();
				Результат = Результат + "  section " + ТЧ.Имя + ": " + Выборка.Число + " rows" + Символы.ПС;
			КонецПопытки;
		КонецЦикла;

		// 6. the test objects are deleted again (the element before its group)
		Для Индекс = 1 По Записаны.Количество() Цикл
			Записаны[Записаны.Количество() - Индекс].ПолучитьОбъект().Удалить();
		КонецЦикла;
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число ИЗ " + ПолноеИмя);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Результат = Результат + "  test objects deleted, rows left: " + Выборка.Число + Символы.ПС;
	Исключение
		Результат = Результат + "  ERROR: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС;
		Для Индекс = 1 По Записаны.Количество() Цикл
			Попытка
				Записаны[Записаны.Количество() - Индекс].ПолучитьОбъект().Удалить();
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецПопытки;
КонецЦикла;
