// S1-C (case c1): widened variable strings of catalogs and documents in one session.
// For each (object, attribute, old limit, new limit): the limit the metadata reports, the existing rows (how
// many, the longest value: a widening must not touch data), the write of a new object with a value of exactly
// the new limit that is read back, found by a query on the attribute, and the XDTO serialization; the test
// object is deleted again. The output has no times or generated names, so two twins can be compared as text.
// No procedure is declared (the job runs through Выполнить()).
Результат = "";
Проверки = Новый Массив;
Проверки.Добавить(Новый Структура("Вид,Имя,Реквизит,Было,Стало", "Справочник", "ШаблоныЗаданийОчереди", "ИмяМетода", 255, 1024));
Проверки.Добавить(Новый Структура("Вид,Имя,Реквизит,Было,Стало", "Справочник", "КлючевыеОперации", "ИмяХеш", 40, 100));
Проверки.Добавить(Новый Структура("Вид,Имя,Реквизит,Было,Стало", "Справочник", "КлассификаторБанков", "Город", 50, 200));
Проверки.Добавить(Новый Структура("Вид,Имя,Реквизит,Было,Стало", "Справочник", "КлассификаторБанков", "ИНН", 12, 20));
Проверки.Добавить(Новый Структура("Вид,Имя,Реквизит,Было,Стало", "Документ", "ТелефонныйЗвонок", "АбонентКакСвязаться", 100, 300));
Проверки.Добавить(Новый Структура("Вид,Имя,Реквизит,Было,Стало", "Документ", "_ДемоЗаказПокупателя", "ГородДоставки", 50, 51));

Для Каждого Описание Из Проверки Цикл
	Попытка
		Вид = Описание.Вид;
		Если Вид = "Справочник" Тогда
			Менеджер = Справочники[Описание.Имя];
			ОбъектМД = Метаданные.Справочники[Описание.Имя];
		Иначе
			Менеджер = Документы[Описание.Имя];
			ОбъектМД = Метаданные.Документы[Описание.Имя];
		КонецЕсли;
		ИмяРеквизита = Описание.Реквизит;
		РеквизитМД = ОбъектМД.Реквизиты[ИмяРеквизита];
		Длина = РеквизитМД.Тип.КвалификаторыСтроки.Длина;
		Результат = Результат + "== " + Вид + "." + ОбъектМД.Имя + "." + ИмяРеквизита + Символы.ПС;
		Результат = Результат + "  limit: " + Длина + " (expected " + Описание.Стало + "): " + (Длина = Описание.Стало) + Символы.ПС;
		Результат = Результат + "  indexing: " + РеквизитМД.Индексирование + Символы.ПС;

		// 1. existing rows: how many, the longest value (the data is what it was)
		Запрос = Новый Запрос("ВЫБРАТЬ " + ИмяРеквизита + " КАК Значение ИЗ " + Вид + "." + ОбъектМД.Имя);
		Выборка = Запрос.Выполнить().Выбрать();
		Строк = 0;
		Самая = 0;
		Сумма = 0;
		Пока Выборка.Следующий() Цикл
			Строк = Строк + 1;
			ТекущаяДлина = СтрДлина(Выборка.Значение);
			Сумма = Сумма + ТекущаяДлина;
			Если ТекущаяДлина > Самая Тогда
				Самая = ТекущаяДлина;
			КонецЕсли;
		КонецЦикла;
		Результат = Результат + "  rows: " + Строк + ", longest value " + Самая + ", total length " + Сумма + Символы.ПС;
		Результат = Результат + "  the longest value fits the old limit: " + (Самая <= Описание.Было) + Символы.ПС;

		// 2. write a new object with a value of exactly the new limit; read back; find by the attribute
		Значение = "";
		Для Индекс = 1 По Описание.Стало Цикл
			Значение = Значение + Сред("абвгдежзик", (Индекс % 10) + 1, 1);
		КонецЦикла;
		Если Вид = "Справочник" Тогда
			НовыйОбъект = Менеджер.СоздатьЭлемент();
			НовыйОбъект.Наименование = "ДДЛ C1 " + ОбъектМД.Имя;
		Иначе
			НовыйОбъект = Менеджер.СоздатьДокумент();
			НовыйОбъект.Дата = Дата(2026, 9, 29, 12, 0, 0);
		КонецЕсли;
		НовыйОбъект.ОбменДанными.Загрузка = Истина;
		НовыйОбъект[ИмяРеквизита] = Значение;
		НовыйОбъект.Записать();
		Ссылка = НовыйОбъект.Ссылка;
		Прочитано = Ссылка[ИмяРеквизита];
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число ИЗ " + Вид + "." + ОбъектМД.Имя + " ГДЕ " + ИмяРеквизита + " = &Значение И Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Значение", Значение);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Найдено = Запрос.Выполнить().Выбрать();
		Найдено.Следующий();
		Результат = Результат + "  wrote " + СтрДлина(Значение) + " characters, read back " + СтрДлина(Прочитано) + ", equal: " + (Прочитано = Значение) + ", found by query: " + (Найдено.Число = 1) + Символы.ПС;

		// 3. the XDTO serialization of the written object holds the whole value
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Ссылка.ПолучитьОбъект());
		Текст = ЗаписьXML.Закрыть();
		Результат = Результат + "  xdto of the written object holds the value: " + (СтрНайти(Текст, Значение) > 0) + Символы.ПС;
		Ссылка.ПолучитьОбъект().Удалить();
		Результат = Результат + "  test object deleted" + Символы.ПС;
	Исключение
		Результат = Результат + "  ERROR: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС;
	КонецПопытки;
КонецЦикла;
