// S1 step 1 (types case T1): the new attributes of five catalogs and a document in one session.
// For every object and every attribute whose name starts with "ДемоТ1": the type the metadata reports, the
// values the existing rows have (NULL / default / other), the XDTO serialization of an existing object
// (needs the model cache row), and a write of a new object with a value of the attribute's type that is
// read back, found by a query on the attribute; the test object is deleted again. The output has no
// times or generated names, so two twins can be compared as text. No procedure is declared (the job runs
// through Выполнить()).
Результат = "";
Объекты = Новый Массив;
Объекты.Добавить(Новый Структура("Вид,Имя", "Справочник", "Удалить_ДемоОбщиеСведения"));
Объекты.Добавить(Новый Структура("Вид,Имя", "Справочник", "КлючевыеОперации"));
Объекты.Добавить(Новый Структура("Вид,Имя", "Справочник", "_ДемоМестаХранения"));
Объекты.Добавить(Новый Структура("Вид,Имя", "Справочник", "_ДемоГруппыДоступаПартнеров"));
Объекты.Добавить(Новый Структура("Вид,Имя", "Справочник", "_ДемоПартнеры"));
Объекты.Добавить(Новый Структура("Вид,Имя", "Документ", "_ДемоЗаказПокупателя"));

Для Каждого Описание Из Объекты Цикл
	Попытка
		Вид = Описание.Вид;
		Если Вид = "Справочник" Тогда
			Менеджер = Справочники[Описание.Имя];
			ОбъектМД = Метаданные.Справочники[Описание.Имя];
		Иначе
			Менеджер = Документы[Описание.Имя];
			ОбъектМД = Метаданные.Документы[Описание.Имя];
		КонецЕсли;
		Результат = Результат + "== " + Вид + "." + ОбъектМД.Имя + Символы.ПС;
		Реквизиты = Новый Массив;
		Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
			Если Лев(Реквизит.Имя, 6) = "ДемоТ1" Тогда
				Реквизиты.Добавить(Реквизит);
				Результат = Результат + "  attribute " + Реквизит.Имя + ": " + Строка(Реквизит.Тип) + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
		Если Реквизиты.Количество() = 0 Тогда
			Результат = Результат + "  NO NEW ATTRIBUTES" + Символы.ПС;
			Продолжить;
		КонецЕсли;

		// 1. existing rows: the distribution of values of each new attribute
		Для Каждого Реквизит Из Реквизиты Цикл
			Запрос = Новый Запрос("ВЫБРАТЬ " + Реквизит.Имя + " КАК Значение ИЗ " + Вид + "." + ОбъектМД.Имя);
			Выборка = Запрос.Выполнить().Выбрать();
			Распределение = Новый Соответствие;
			Пока Выборка.Следующий() Цикл
				Ключ = "[" + Строка(Выборка.Значение) + "] " + Строка(ТипЗнч(Выборка.Значение));
				Распределение.Вставить(Ключ, ?(Распределение[Ключ] = Неопределено, 0, Распределение[Ключ]) + 1);
			КонецЦикла;
			Список = Новый СписокЗначений;
			Для Каждого Пара Из Распределение Цикл
				Список.Добавить(Пара.Ключ + " x" + Пара.Значение);
			КонецЦикла;
			Список.СортироватьПоЗначению();
			Строки = "";
			Для Каждого Элемент Из Список Цикл
				Строки = Строки + Элемент.Значение + "; ";
			КонецЦикла;
			Результат = Результат + "  rows " + Реквизит.Имя + ": " + Строки + Символы.ПС;
		КонецЦикла;

		// 2. XDTO serialization of an existing object
		Выборка = Менеджер.Выбрать();
		Найден = Ложь;
		Пока Выборка.Следующий() Цикл
			Если Вид = "Справочник" И Выборка.ЭтоГруппа Тогда
				Продолжить;
			КонецЕсли;
			Объект = Выборка.ПолучитьОбъект();
			ЗаписьXML = Новый ЗаписьXML;
			ЗаписьXML.УстановитьСтроку();
			СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Объект);
			Текст = ЗаписьXML.Закрыть();
			Пропало = "";
			Для Каждого Реквизит Из Реквизиты Цикл
				Если СтрНайти(Текст, "<" + Реквизит.Имя) = 0 Тогда
					Пропало = Пропало + Реквизит.Имя + " ";
				КонецЕсли;
			КонецЦикла;
			Результат = Результат + "  xdto: the serialization has all new attributes: " + (Пропало = "") + ?(Пропало = "", "", " missing: " + Пропало) + Символы.ПС;
			Найден = Истина;
			Прервать;
		КонецЦикла;
		Если Не Найден Тогда
			Результат = Результат + "  xdto: no object to serialize" + Символы.ПС;
		КонецЕсли;

		// 3. write a new object, read back, query by the attribute
		Если Вид = "Справочник" Тогда
			НовыйОбъект = Менеджер.СоздатьЭлемент();
			НовыйОбъект.Наименование = "ДДЛ T1 " + ОбъектМД.Имя;
		Иначе
			НовыйОбъект = Менеджер.СоздатьДокумент();
			НовыйОбъект.Дата = Дата(2026, 9, 29, 12, 0, 0);
		КонецЕсли;
		Задано = Новый Соответствие;
		Для Каждого Реквизит Из Реквизиты Цикл
			Типы = Реквизит.Тип.Типы();
			Значение = Неопределено;
			Если Типы.Количество() = 1 Тогда
				Если Типы[0] = Тип("Булево") Тогда
					Значение = Истина;
				ИначеЕсли Типы[0] = Тип("Строка") Тогда
					Значение = "значение";
				ИначеЕсли Типы[0] = Тип("Число") Тогда
					Значение = ?(Реквизит.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти > 0, 3.5, 42);
				ИначеЕсли Типы[0] = Тип("Дата") Тогда
					Значение = Дата(2026, 9, 29, 13, 14, 15);
				КонецЕсли;
			КонецЕсли;
			Если Значение <> Неопределено Тогда
				НовыйОбъект[Реквизит.Имя] = Значение;
				Задано.Вставить(Реквизит.Имя, Значение);
			КонецЕсли;
		КонецЦикла;
		НовыйОбъект.Записать();
		Ссылка = НовыйОбъект.Ссылка;
		Для Каждого Реквизит Из Реквизиты Цикл
			Если Задано[Реквизит.Имя] <> Неопределено Тогда
				Прочитано = Ссылка[Реквизит.Имя];
				Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число ИЗ " + Вид + "." + ОбъектМД.Имя + " ГДЕ " + Реквизит.Имя + " = &Значение И Ссылка = &Ссылка");
				Запрос.УстановитьПараметр("Значение", Задано[Реквизит.Имя]);
				Запрос.УстановитьПараметр("Ссылка", Ссылка);
				Выборка = Запрос.Выполнить().Выбрать();
				Выборка.Следующий();
				Результат = Результат + "  wrote " + Реквизит.Имя + " = [" + Строка(Задано[Реквизит.Имя]) + "], read back [" + Строка(Прочитано) + "], found by query: " + (Выборка.Число = 1) + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Ссылка.ПолучитьОбъект());
		Текст = ЗаписьXML.Закрыть();
		Результат = Результат + "  xdto of the written object: " + (СтрДлина(Текст) > 0) + Символы.ПС;
		Ссылка.ПолучитьОбъект().Удалить();
		Результат = Результат + "  test object deleted" + Символы.ПС;
	Исключение
		Результат = Результат + "  ERROR: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС;
	КонецПопытки;
КонецЦикла;
