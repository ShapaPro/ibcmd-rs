// S1-F: deletes what the session job f_created.bsl left in a twin when it stopped on an error (all elements and documents of the
// new objects ДемоКатН*, ДемоДокН*), so that the outputs of two twins compare. The variable Результат says how many.
Результат = "";
Для Каждого ОбъектМД Из Метаданные.Справочники Цикл
	Если Не СтрНачинаетсяС(ОбъектМД.Имя, "ДемоКатН") Тогда
		Продолжить;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка КАК Ссылка ИЗ Справочник." + ОбъектМД.Имя + " КАК Т");
	Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Для Индекс = 1 По Ссылки.Количество() Цикл
		Объект = Ссылки[Ссылки.Количество() - Индекс].ПолучитьОбъект();
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Удалить();
	КонецЦикла;
	Результат = Результат + ОбъектМД.Имя + ": " + Ссылки.Количество() + Символы.ПС;
КонецЦикла;
Для Каждого ОбъектМД Из Метаданные.Документы Цикл
	Если Не СтрНачинаетсяС(ОбъектМД.Имя, "ДемоДокН") Тогда
		Продолжить;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка КАК Ссылка ИЗ Документ." + ОбъектМД.Имя + " КАК Т");
	Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Для Каждого Ссылка Из Ссылки Цикл
		Объект = Ссылка.ПолучитьОбъект();
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Удалить();
	КонецЦикла;
	Результат = Результат + ОбъектМД.Имя + ": " + Ссылки.Количество() + Символы.ПС;
КонецЦикла;
